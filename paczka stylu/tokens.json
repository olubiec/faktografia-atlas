{
  "$opis": "Tokeny systemu stylu Faktografia 'Kalka i korekta'. Jedyne źródło kolorów, krojów i odstępów. Opis zasad: docs/STYL.md.",
  "color": {
    "light": {
      "kalka": "#EEF1EF",
      "arkusz": "#F8FAF9",
      "linia": "#C5CDD3",
      "tusz": "#15233F",
      "olowek": "#4D5B72",
      "korekta": "#E3242B",
      "korektaTekst": "#B8141C",
      "ochra": "#C77700",
      "ochraTekst": "#8F5600"
    },
    "dark": {
      "kalka": "#0F1A30",
      "arkusz": "#16233D",
      "linia": "#2A3A5C",
      "tusz": "#E7ECF3",
      "olowek": "#A9B6CA",
      "korekta": "#FF5A5F",
      "korektaTekst": "#FF7A7E",
      "ochra": "#F0A33A",
      "ochraTekst": "#F0A33A"
    }
  },
  "data": {
    "sequential": {
      "light": ["#D6DEEA", "#A9B8CF", "#7088AE", "#3D5A8A", "#15233F"],
      "dark": ["#22345A", "#3D5A8A", "#5F7DB0", "#8FA6CC", "#D6DEEA"]
    },
    "diverging": {
      "light": ["#C77700", "#E4B66B", "#F8FAF9", "#7088AE", "#15233F"],
      "dark": ["#F0A33A", "#9A6A2A", "#16233D", "#5F7DB0", "#D6DEEA"]
    },
    "noData": { "light": "#F8FAF9", "dark": "#16233D", "pattern": "kropki w kolorze 'linia'" },
    "highlight": "korekta"
  },
  "font": {
    "sans": "'Atkinson Hyperlegible Next', system-ui, sans-serif",
    "mono": "'Atkinson Hyperlegible Mono', ui-monospace, monospace",
    "packages": ["@fontsource/atkinson-hyperlegible-next", "@fontsource/atkinson-hyperlegible-mono"],
    "weights": { "text": 400, "subtitle": 500, "heading": 700, "title": 800 },
    "scale": { "xs": 13, "sm": 17, "md": 20, "lg": 25, "xl": 31, "2xl": 39, "3xl": 49, "4xl": 61, "5xl": 76 },
    "bodySize": 17,
    "bodyLineHeight": 1.6,
    "headingLineHeight": 1.1,
    "headingTracking": "-0.02em",
    "maxLineLength": "70ch"
  },
  "space": { "unit": 4, "scale": [4, 8, 12, 16, 24, 32, 48, 64, 96] },
  "radius": { "default": 0 },
  "border": { "width": 1, "color": "linia", "strong": "tusz" },
  "shadow": "none",
  "motion": {
    "fast": 150,
    "base": 300,
    "slow": 600,
    "drawOutline": 1200,
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "reducedMotion": "wszystkie czasy 0, bez animacji wejścia"
  },
  "annotation": {
    "library": "rough-notation",
    "color": "korekta",
    "strokeWidth": 2.5,
    "iterations": 2,
    "padding": 6,
    "animationDuration": 600,
    "maxPerScreen": 1,
    "types": ["circle", "underline", "bracket", "box"]
  },
  "icons": { "library": "iconoir-react", "strokeWidth": 1.5, "size": 20 },
  "touchTarget": 44,
  "breakpoints": { "mobile": 390, "tablet": 768, "desktop": 1280, "wide": 1440 }
}
