{
  "name": "faktografia-atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/tokens.mjs",
    "prebuild": "node scripts/tokens.mjs",
    "tokens": "node scripts/tokens.mjs",
    "geo": "node scripts/geo/build.mjs",
    "units": "node scripts/geo/units.mjs",
    "kalka": "node scripts/geo/kalka.mjs",
    "map-units": "node scripts/data/map-units.mjs",
    "data:fetch": "node scripts/data/fetch-values.mjs",
    "localities": "node scripts/geo/localities.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "shots": "node scripts/shots.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e && pnpm shots",
    "preview": "vite preview"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/extensions": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@observablehq/plot": "^0.6.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "iconoir-react": "^7.12.1",
    "maplibre-gl": "^6.14.0",
    "minisearch": "^7.2.0",
    "p-throttle": "^8.1.1",
    "posthog-js": "^1.438.12",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-map-gl": "^8.1.3",
    "react-modal-sheet": "^5.6.0",
    "react-router": "^8.4.0",
    "rough-notation": "^0.5.1",
    "roughjs": "^4.6.6",
    "tailwind-merge": "^3.7.0",
    "topojson-client": "^3.1.0",
    "tweakpane": "^4.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "mapshaper": "^0.7.87",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "topojson-server": "^3.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
